# Disalin jadi .env untuk pengembangan lokal, dan disetel di Vercel
# lewat Project Settings -> Environment Variables.

# ID spreadsheet: bagian setelah /d/ pada URL-nya.
SHEET_ID=1pZo71Xc4gcpfmsbyP38hycP7ftUHIT3E0J7bGjjL3UM

# gid tab yang dibaca. Arahkan ke tab PUBLIK setelah dibuat, bukan tab utama --
# tab utama memuat nomor WhatsApp dan email yang tidak boleh terbaca umum.
SHEET_GID=2123794245

# Tautan Google Form pengajuan. Bila kosong, menu "Ajukan" disembunyikan.
VITE_URL_FORM=https://docs.google.com/forms/d/e/1FAIpQLSdn13aadHL8-KCxf7nX6Mn_kCfFd0LSsLaq0jn82CDRgRorqw/viewform?usp=send_form

# Tampilkan nomor WhatsApp dan email pemohon di halaman detail.
# 0 = sembunyikan (tidak ikut terkirim ke peramban sama sekali).
TAMPILKAN_KONTAK=1
