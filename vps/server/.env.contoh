# Salin jadi .env lalu isi. Berkas .env tidak pernah masuk git.

PORT=3101
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=simpel
DB_PASSWORD=
DB_NAME=simpel

# Minimal 32 karakter. Hasilkan dengan: openssl rand -hex 32
JWT_SECRET=

# OAuth akun Bagian Hukum. Dapatkan lewat: npm run token
#
# Jangan pakai Service Account: service account tidak punya kuota penyimpanan
# Drive sendiri, sehingga mengunggah ke Drive akun Gmail biasa gagal dengan
# "Service Accounts do not have storage quota".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Folder Drive tujuan berkas pengajuan dan hasil export
DRIVE_FOLDER_ID=

# Spreadsheet lama - hanya dibaca sekali saat migrasi awal.
# Boleh dikosongkan setelah migrasi selesai.
SHEETS_ID=

# Cadangan harian: satu berkas Excel per hari, disimpan CADANGAN_SIMPAN_HARI
# berkas terbaru. Yang lebih tua terhapus sendiri.
DIR_CADANGAN=/opt/simpel/cadangan
CADANGAN_SIMPAN_HARI=7

# Alamat situs, dipakai menyusun URL berkas di dalam lembar ekspor supaya bisa
# diklik langsung dari Excel. Kosong berarti URL-nya relatif dan hanya berguna
# di dalam peramban.
BASE_URL=https://simple.jdih.contoh.id
