[Unit]
Description=SIMPEL Hukum Brebes
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=finnacantik
WorkingDirectory=/opt/simpel/server
EnvironmentFile=/opt/simpel/server/.env

# Jam proses Node disamakan dengan WIB.
#
# Disebut tegas di sini, bukan mengandalkan zona sistem saja: kebanyakan VPS
# dikirim dengan Etc/UTC, dan kalau itu terlewat, seluruh catatan waktu meleset
# tujuh jam tanpa ada yang salah secara mencolok -- log pukul 01.48 sebenarnya
# 08.48, dan baru ketahuan saat ada yang menelusuri kejadian.
#
# Zona sistem dan MariaDB juga harus disetel; lihat DOKUMENTASI.md bagian
# "Zona waktu".
Environment=TZ=Asia/Jakarta
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

# VPS hanya punya 842 MB dan dibagi dengan semar, combis-queue, php-fpm,
# mariadb, dan caddy. Tanpa batas ini, kebocoran memori SIMPEL bisa membuat
# OOM killer memilih tetangganya sebagai korban -- dan yang mati justru
# jdih.marazystudio.my.id yang tidak bersalah.
MemoryMax=200M
MemoryHigh=160M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/simpel

StandardOutput=journal
StandardError=journal
SyslogIdentifier=simpel

[Install]
WantedBy=multi-user.target
