# DUA VARIAN. Pilih satu sesuai cara lalu lintas masuk.
#
# Varian A -- di balik Cloudflare Tunnel (yang dipakai server 38.253.224.32
# sejak 19 Agustus 2026). Tanpa nama domain sama sekali: tunnel meneruskan ke
# http://localhost:80 apa pun Host header-nya, dan routing hostname-nya diatur
# di dashboard Cloudflare, bukan di sini. Menuliskan nama domain justru membuat
# Caddy mencoba menerbitkan sertifikat Let's Encrypt lewat port 80 yang tidak
# diteruskan provider, sampai jatah percobaannya habis tanpa pernah berhasil.
# TLS-nya ditangani Cloudflare di tepi, dan jalur tunnel-nya sudah terenkripsi.
#
#   :80 {
#       ... isi blok yang sama persis seperti di bawah ...
#   }
#
# Varian B -- port 80 dan 443 benar-benar diteruskan ke VM. Pakai blok bernama
# di bawah ini supaya Caddy mengurus Let's Encrypt sendiri.
#
# Kalau server dipakai bersama aplikasi lain, jangan sentuh blok milik mereka.

simple.jdih.marazystudio.my.id {
	# Frontend: hasil `npm run build` di vps/web
	root * /opt/simpel/web

	# API diteruskan ke Express yang hanya mendengar di localhost
	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}

	# React Router memakai path biasa, bukan hash. Tanpa fallback ini,
	# membuka /detail/BRB-2026-0001 langsung dari alamat akan 404 karena
	# tidak ada berkas dengan nama itu.
	handle {
		try_files {path} /index.html
		file_server
	}

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Sengaja tanpa blok `log`: journald sudah menangkap seluruh keluaran Caddy
	# (`journalctl -u caddy`), dan berkas log tersendiri hanya menambah satu hal
	# yang harus dirotasi di disk yang dipakai bersama tiga aplikasi lain.
}
